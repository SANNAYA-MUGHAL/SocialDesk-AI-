{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/posts.json"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js?apiPath=:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/index.js?uploadPath=:match*"
    }
  ]
}
